# Toutes les adresses passent par index.php, sauf les fichiers qui existent (feuilles de style, images).
RewriteEngine On
# Transmet l'en-tête « Authorization: Bearer … » de l'API à PHP (supprimé sinon par certains hébergements).
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Avant l'ouverture : site réservé à l'adresse IP de TepanSofts (ajouter une ligne RewriteCond par adresse
# autorisée) ; les autres visiteurs voient la page « Nous arrivons bientôt ». Supprimer ce bloc à l'ouverture.
RewriteCond %{REMOTE_ADDR} !^88\.187\.160\.248$
RewriteCond %{REQUEST_URI} !(bientot\.html|/assets/img/logo\.png|/favicon\.ico)$
RewriteRule ^ bientot.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]

Options -Indexes
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
